// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  company   String
  role      String?
  phone     String
  whatsapp  String?
  email     String?
  sector    String?
  orgType   String?
  source    String
  isComplete Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  leads     Lead[]
  feedback  VisitorFeedback[]
}

model Lead {
  id              String   @id @default(cuid())
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String
  solutions       String[]
  mainSolution    String
  need            String?
  hasConcreteNeed String
  timeframe       String?
  interest        String
  status          String
  ownerId         String
  nextAction      String
  followUpDate    DateTime?
  notes           String?
  estimatedValue  Int?
  createdAt       DateTime @default(now())
  interactions    Interaction[]
  followUps       FollowUp[]
  meetings        Meeting[]
}

model Interaction {
  id          String   @id @default(cuid())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  type        String
  description String
  date        DateTime @default(now())
  userId      String
}

model FollowUp {
  id      String   @id @default(cuid())
  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId  String
  action  String
  dueDate DateTime
  ownerId String
  status  String
}

model Meeting {
  id       String   @id @default(cuid())
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId   String
  type     String
  start    DateTime
  end      DateTime
  ownerId  String
  location String?
}

model VisitorFeedback {
  id           String   @id @default(cuid())
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId    String?
  overall      Int
  team         Int
  presentation Int
  relevance    Int
  highlights   String[]
  wantsSolution String?
  wantsContact Boolean
  comment      String?
  createdAt    DateTime @default(now())
}

model BrainUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  initials     String
  status       String   @default("Pendente")
  createdAt    DateTime @default(now())
}

model Notification {
  id     String   @id @default(cuid())
  title  String
  detail String
  date   String
  read   Boolean  @default(false)
  href   String
}

model SolutionItem {
  id       String @id @default(cuid())
  name     String @unique
  subtitle String
}

model InternalEvaluation {
  id            String   @id @default(cuid())
  scores        Json
  wentWell      String?
  difficulties  String?
  topSolutions  String[]
  mainNeeds     String?
  improvements  String?
  savedAt       DateTime @updatedAt
}
