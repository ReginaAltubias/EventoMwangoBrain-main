



# ——— API do IMA (BI + NIF) ———
VITE_IMA_BASE_URL="https://api.gov.ao"
VITE_IMA_USERNAME=""
VITE_IMA_PASSWORD=""
VITE_IMA_MODO="api"

# ——— Neon (Postgres) — usado pelo Prisma, apenas no servidor ———
DATABASE_URL=""
DIRECT_URL=""

# ——— API do módulo brain (server/) ———
# API_PORT só afecta o servidor Express local.
# VITE_API_URL NÃO deve estar aqui nem na Vercel — vai em .env.development
# (só carregado em "npm run dev"; nunca entra num build de produção).
API_PORT=8787

# ——— Notificações por e-mail (Resend) ———
# Enquanto estas duas não estiverem definidas, a notificação é ignorada
# silenciosamente — o registo do contacto nunca falha por causa disto.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM="onboarding@resend.dev"

# ——— SMS / WhatsApp ao cliente (Twilio) ———
# Conta gratuita em twilio.com. Enquanto estas não estiverem definidas,
# o SMS é ignorado silenciosamente — o registo do contacto nunca falha.
# Para WhatsApp Sandbox: TWILIO_FROM="whatsapp:+14155238886"
# Para SMS normal:       TWILIO_FROM="+1XXXXXXXXXX"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
