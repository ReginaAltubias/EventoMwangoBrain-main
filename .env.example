



# ——— API do IMA (BI + NIF) ———
VITE_IMA_BASE_URL="https://api.gov.ao"
VITE_IMA_USERNAME=""
VITE_IMA_PASSWORD=""
VITE_IMA_MODO="api"

# ——— Neon (Postgres) — usado pelo Prisma, apenas no servidor ———
DATABASE_URL=""
DIRECT_URL=""

# ——— API do módulo brain (server/) ———
